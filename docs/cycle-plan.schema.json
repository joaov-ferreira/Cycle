{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joaov-ferreira/Cycle/blob/main/docs/cycle-plan.schema.json",
  "title": "CYCLE plan (cycle-plan v1)",
  "description": "Training plan document imported by the CYCLE app. Normative text: docs/IMPORT_FORMAT.md. Unknown properties are ignored by the importer.",
  "type": "object",
  "required": [
    "format",
    "version",
    "name",
    "workouts"
  ],
  "properties": {
    "format": {
      "const": "cycle-plan"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "sessionsPerWeek": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "cycle": {
      "$ref": "#/$defs/cycle"
    },
    "customExercises": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/customExercise"
      }
    },
    "referenceMaxes": {
      "type": "array",
      "maxItems": 50,
      "description": "Current 1RMs (CYCLE 4.0 or later). A value is saved only for an exercise without a reference 1RM.",
      "items": {
        "$ref": "#/$defs/referenceMax"
      }
    },
    "workouts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/workout"
      }
    }
  },
  "$defs": {
    "muscleGroup": {
      "enum": [
        "chest",
        "back",
        "shoulders",
        "traps",
        "biceps",
        "triceps",
        "forearms",
        "abs",
        "lowerBack",
        "glutes",
        "quads",
        "hamstrings",
        "adductors",
        "abductors",
        "calves"
      ]
    },
    "equipment": {
      "enum": [
        "barbell",
        "dumbbell",
        "machine",
        "cable",
        "smith",
        "kettlebell",
        "bodyweight",
        "band",
        "other"
      ]
    },
    "cycle": {
      "type": "object",
      "properties": {
        "loadWeeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 6
        },
        "deloadWeeks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 1
        },
        "deloadVolumeFactor": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 1,
          "default": 0.5
        },
        "deloadLoadFactor": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1,
          "default": 0.9
        },
        "rirRamp": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          },
          "description": "Target RIR falling from start (first load week) to end (last load week); start must be >= end."
        }
      }
    },
    "customExercise": {
      "type": "object",
      "required": [
        "key",
        "name",
        "primaryMuscle",
        "equipment"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "primaryMuscle": {
          "$ref": "#/$defs/muscleGroup"
        },
        "secondaryMuscles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/muscleGroup"
          },
          "default": []
        },
        "equipment": {
          "$ref": "#/$defs/equipment"
        },
        "mechanics": {
          "enum": [
            "compound",
            "isolation"
          ],
          "default": "compound"
        }
      }
    },
    "workout": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "programs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "description": "Program blocks generated before the exercises (CYCLE 4.0 or later).",
          "items": {
            "$ref": "#/$defs/programBlock"
          }
        },
        "exercises": {
          "type": "array",
          "minItems": 0,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/planExercise"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "exercises"
          ],
          "properties": {
            "exercises": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "programs"
          ],
          "properties": {
            "programs": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "planExercise": {
      "type": "object",
      "required": [
        "exercise"
      ],
      "properties": {
        "exercise": {
          "type": "string",
          "minLength": 1,
          "description": "A customExercises key, a built-in exercise id, or an exercise name (IMPORT_FORMAT.md §3)."
        },
        "sets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "Required unless percent is given; ignored with percent."
        },
        "repMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "repMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "reps": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "string",
              "pattern": "^\\s*[0-9]{1,3}\\s*(-\\s*[0-9]{1,3}\\s*)?$"
            }
          ]
        },
        "percent": {
          "$ref": "#/$defs/percentScheme"
        },
        "rir": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "rest": {
          "type": "integer",
          "minimum": 0,
          "maximum": 900
        },
        "startLoad": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "superset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "description": "Label shared by 2-4 consecutive exercises performed back to back."
        }
      },
      "if": {
        "required": [
          "percent"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "rir"
              ]
            },
            {
              "required": [
                "startLoad"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "sets"
        ],
        "anyOf": [
          {
            "required": [
              "reps"
            ]
          },
          {
            "required": [
              "repMin",
              "repMax"
            ]
          }
        ]
      }
    },
    "percentScheme": {
      "type": "object",
      "required": [
        "weeks"
      ],
      "description": "Loads as percentages of a reference 1RM (CYCLE 4.0 or later). rir and startLoad are not allowed with it. At most 40 sets per week; at least one week must have groups.",
      "properties": {
        "weeks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "array",
            "maxItems": 20,
            "description": "One week: groups of identical sets. [] = the exercise is not trained that week.",
            "items": {
              "$ref": "#/$defs/percentGroup"
            }
          }
        },
        "startWeek": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1,
          "description": "Scheme week of the first cycle week; at most the number of weeks."
        },
        "of": {
          "type": "string",
          "minLength": 1,
          "description": "Exercise whose 1RM the percentages refer to (default: the exercise itself)."
        }
      }
    },
    "percentGroup": {
      "type": "object",
      "required": [
        "reps"
      ],
      "properties": {
        "sets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 1
        },
        "reps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "percent": {
          "type": "number",
          "minimum": 1,
          "maximum": 120,
          "multipleOf": 0.5
        },
        "addKg": {
          "type": "number",
          "minimum": -100,
          "maximum": 100,
          "default": 0
        },
        "amrap": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "programBlock": {
      "type": "object",
      "required": [
        "program",
        "day",
        "roles"
      ],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a built-in program."
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "description": "At most the days per week of the program."
        },
        "startWeek": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "At most the duration of the program in weeks."
        },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "description": "Role id to exercise reference.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessories": {
          "type": "boolean",
          "default": false
        },
        "params": {
          "type": "object",
          "description": "Program parameter id to value, within the parameter range and step.",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "referenceMax": {
      "type": "object",
      "required": [
        "exercise",
        "kg"
      ],
      "properties": {
        "exercise": {
          "type": "string",
          "minLength": 1
        },
        "kg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "description": "At most 2 decimals."
        }
      }
    }
  }
}
